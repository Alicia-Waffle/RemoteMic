#!/bin/zsh
set -u

/usr/sbin/chown -R root:wheel "/Library/Audio/Plug-Ins/HAL/RemoteMicDriver.driver"
/usr/bin/find "/Library/Audio/Plug-Ins/HAL/RemoteMicDriver.driver" -type d -exec /bin/chmod 755 {} \;
/usr/bin/find "/Library/Audio/Plug-Ins/HAL/RemoteMicDriver.driver" -type f -exec /bin/chmod 644 {} \;
/bin/chmod 755 "/Library/Audio/Plug-Ins/HAL/RemoteMicDriver.driver/Contents/MacOS/BlackHole"
/bin/rm -rf "/Library/Audio/Plug-Ins/HAL/vRemoteDriver.driver"

/usr/bin/killall -9 coreaudiod 2>/dev/null || true
/usr/bin/pkill -TERM -x RemoteMic 2>/dev/null || true
/usr/bin/pkill -TERM -x vRemote 2>/dev/null || true
/bin/rm -rf "/Applications/vRemote.app"

console_user=$(/usr/bin/stat -f '%Su' /dev/console)
if [[ -n "$console_user" && "$console_user" != "root" ]]; then
  console_uid=$(/usr/bin/id -u "$console_user")
  /bin/launchctl asuser "$console_uid" \
    /usr/bin/sudo -u "$console_user" \
    /usr/bin/open -n "/Applications/RemoteMic.app" >/dev/null 2>&1 || true
fi

exit 0
